{
  "name": "webrtc-gamification-ui",
  "version": "1.0.0-alpha",
  "description": "Angular UI application for WebRTC integration with AlephScript and orchestration system",
  "keywords": ["webrtc", "angular", "alephscript", "p2p", "gamification"],
  "license": "AIPL",
  "main": "dist/index.js",
  "files": [
    "dist/**/*",
    "scripts/postinstall.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/escrivivir-co/web-rtc-gamify-ui"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build web-rtc-gamify-ui",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "postinstall": "node scripts/postinstall.cjs || echo 'Postinstall completed'",
    "addlibrary": "npx ng generate library NAME --prefix=PREFIX",
    "addApp": "npx ng generate application NAME --routing=false --style=css"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.2.0",
    "typescript": "~5.9.2"
  }
}